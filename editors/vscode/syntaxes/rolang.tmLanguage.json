{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rolang",
  "scopeName": "source.rolang",
  "fileTypes": ["rl"],
  "patterns": [
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords_control" },
    { "include": "#keywords_async" },
    { "include": "#keywords_storage" },
    { "include": "#keywords_decl" },
    { "include": "#keywords_cast" },
    { "include": "#keywords_other" },
    { "include": "#types_builtin" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#function_call" },
    { "include": "#type_reference" }
  ],
  "repository": {

    "block_comment": {
      "name": "comment.block.rolang",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.rolang" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.comment.end.rolang" } }
    },

    "line_comment": {
      "name": "comment.line.double-slash.rolang",
      "match": "//.*$"
    },

    "strings": {
      "name": "string.quoted.double.rolang",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.rolang" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.rolang" } },
      "patterns": [
        {
          "name": "constant.character.escape.rolang",
          "match": "\\\\([nrt\\\\\"0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "comment": "Function definition: def funcName",
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.rolang" },
            "2": { "name": "entity.name.function.rolang" }
          }
        },
        {
          "comment": "Struct declaration: struct TypeName",
          "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.struct.rolang" },
            "2": { "name": "entity.name.type.struct.rolang" }
          }
        },
        {
          "comment": "Enum declaration: enum TypeName",
          "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.enum.rolang" },
            "2": { "name": "entity.name.type.enum.rolang" }
          }
        },
        {
          "comment": "Protocol declaration: protocol ProtoName",
          "match": "\\b(protocol)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.protocol.rolang" },
            "2": { "name": "entity.name.type.protocol.rolang" }
          }
        },
        {
          "comment": "Extension declaration: extension TypeName",
          "match": "\\b(extension)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.extension.rolang" },
            "2": { "name": "entity.name.type.rolang" }
          }
        }
      ]
    },

    "keywords_control": {
      "name": "keyword.control.rolang",
      "match": "\\b(if|else|while|for|switch|case|default|guard|defer|return|break|continue|in|where)\\b"
    },

    "keywords_async": {
      "name": "keyword.control.async.rolang",
      "match": "\\b(async|await|throws|throw|try)\\b"
    },

    "keywords_storage": {
      "name": "storage.modifier.rolang",
      "match": "\\b(pub|private|internal|static|unsafe)\\b"
    },

    "keywords_decl": {
      "name": "keyword.declaration.rolang",
      "match": "\\b(import|extern|associatedtype)\\b"
    },

    "keywords_cast": {
      "patterns": [
        { "name": "keyword.operator.cast.optional.rolang", "match": "\\bas\\?" },
        { "name": "keyword.operator.cast.forced.rolang",   "match": "\\bas!" },
        { "name": "keyword.operator.cast.rolang",          "match": "\\b(as|is)\\b" }
      ]
    },

    "keywords_other": {
      "name": "keyword.other.rolang",
      "match": "\\b(any|Self|self|sizeof|typeof|alignof|clone|drop)\\b"
    },

    "types_builtin": {
      "name": "support.type.primitive.rolang",
      "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|Bool|Void|RawPtr)\\b"
    },

    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.rolang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.rolang",
          "match": "\\bnil\\b"
        },
        {
          "name": "constant.numeric.float.rolang",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.hex.rolang",
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.binary.rolang",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.integer.rolang",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.rolang",      "match": "->" },
        { "name": "keyword.operator.range.rolang",      "match": "\\.\\.<|\\.\\." },
        { "name": "keyword.operator.optional.rolang",   "match": "\\?\\?|\\?\\." },
        { "name": "keyword.operator.comparison.rolang", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.rolang",    "match": "&&|\\|\\|" },
        { "name": "keyword.operator.bitwise.rolang",    "match": "<<|>>|[&|^~]" },
        { "name": "keyword.operator.assign.rolang",     "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=" },
        { "name": "keyword.operator.assign.rolang",     "match": "=" },
        { "name": "keyword.operator.arithmetic.rolang", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.postfix.rolang",    "match": "!|\\?" }
      ]
    },

    "function_call": {
      "comment": "Lowercase function/method calls: foo(",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.rolang" }
      }
    },

    "type_reference": {
      "comment": "CamelCase type references",
      "name": "entity.name.type.rolang",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    }
  }
}
